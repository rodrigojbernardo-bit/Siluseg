# Copiá este archivo a `.env` y completá los valores reales.
# El archivo `.env` NO se versiona (está en .gitignore).

# Carpeta exclusiva del bot con el perfil de Chrome ya "calentado".
FP_CHROME_PERFIL=C:\Users\User\Desktop\SVO AUTOMATICO\chrome_perfil_bot

# Portal de login de Federación Patronal.
FP_URL_LOGIN=https://www.fedpat.com.ar/

# Credenciales del portal.
FP_USUARIO=
FP_PASSWORD=

# Ajustes opcionales (valores por defecto entre paréntesis).
# FP_TIMEOUT_LOGIN_MS=60000
# FP_PAUSA_ESTABILIZACION_S=5
# FP_SLOW_MO_MS=500
# FP_HEADLESS=0
